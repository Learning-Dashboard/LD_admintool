# LD Admin Tool local configuration.
# Docker receives LD_API_KEY from the root .env; use this file only for standalone runs.

ADMINTOOL_PORT=8080
ADMINTOOL_LD_API_URL=http://localhost:8888/api
ADMINTOOL_EVAL_URL=http://localhost:5001

# Generate once in the repository root:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Copy the same value from the root .env.
LD_API_KEY=

DB_HOST=localhost
DB_PORT=5433
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=example
