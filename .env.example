# LD Admin Tool local configuration.
# Docker receives LD_API_KEY from the root .env; use this file only for standalone runs.

ADMINTOOL_PORT=8080
ADMINTOOL_LD_API_URL=http://localhost:8888/api
ADMINTOOL_EVAL_URL=http://localhost:5001

# Generate once in the repository root:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Copy the same value from the root .env.
LD_API_KEY=

DB_HOST=localhost
DB_PORT=5433
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=example

# Per-subject credentials (GitHub token, Taiga server, teams): the same file that
# LD Connect uses. In Docker it is mounted at /app/config_files.
CREDENTIALS_FILE=../LD_Connect_Event/config_files/credentials_config.json

# Fallback Taiga, used by the subjects that leave taiga_api_url and
# taiga_auth_url empty in the credentials file. Same values as in LD Connect.
TAIGA_FALLBACK_API_URL=https://api.taiga.io/api/v1
TAIGA_FALLBACK_AUTH_URL=https://api.taiga.io/api/v1/auth
TAIGA_FALLBACK_USERNAME=
TAIGA_FALLBACK_PASSWORD=
